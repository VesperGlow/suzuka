{{- $items := slice -}}
{{- range (where hugo.Sites.Default.RegularPages "Section" "posts").ByDate.Reverse -}}
  {{- $post := . -}}
  {{- range where .Translations "Language.Lang" site.Language.Lang -}}
    {{- $post = . -}}
  {{- end -}}
  {{- $items = $items | append (dict
    "title" $post.Title
    "url" $post.RelPermalink
    "date" ($post.Date.Format "2006-01-02")
  ) -}}
{{- end -}}
{{- dict "items" $items | jsonify -}}
