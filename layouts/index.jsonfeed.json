{{- $base := strings.TrimSuffix "/" site.BaseURL -}}
{{- $items := slice -}}
{{- $pages := (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}{{- $pages = $pages | first $limit -}}{{- end -}}
{{- range $pages -}}
  {{- $content := .Content | replaceRE `((?:src|href)=")/` (printf `${1}%s/` $base) -}}
  {{- $item := dict
    "id" .Permalink
    "url" .Permalink
    "title" .Title
    "content_html" $content
    "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "date_modified" (.Lastmod.Format "2006-01-02T15:04:05Z07:00")
    "tags" (.Params.tags | default (slice))
  -}}
  {{- with .Description | default (.Summary | plainify) -}}
    {{- $item = merge $item (dict "summary" .) -}}
  {{- end -}}
  {{- with .Params.images -}}
    {{- with index . 0 -}}
      {{- $item = merge $item (dict "image" (. | absURL)) -}}
    {{- end -}}
  {{- end -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- dict
  "version" "https://jsonfeed.org/version/1.1"
  "title" site.Title
  "home_page_url" site.Home.Permalink
  "feed_url" (.OutputFormats.Get "JSONFeed").Permalink
  "description" site.Params.description
  "language" site.Language.Locale
  "authors" (slice (dict "name" site.Params.author))
  "items" $items
  | jsonify (dict "prefix" "" "indent" "  ")
-}}
