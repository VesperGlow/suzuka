# 多阶段构建：纯 Go 的 modernc.org/sqlite 无需 CGO，直接产出静态二进制塞进 scratch。
FROM docker.io/library/golang:1.24-alpine AS build

WORKDIR /src

# 先拷依赖清单，利用层缓存。
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# 纯 Go 编译：关掉 CGO 即得到天然静态、无 libc 依赖的二进制。
RUN CGO_ENABLED=0 GOOS=linux \
    go build -trimpath -ldflags '-s -w' -o /out/backend .

# 预创建数据目录并赋给非 root 运行用户：scratch 无 shell，运行期无法 chown。
RUN mkdir -p /data && chown 65534:65534 /data

# 运行镜像：scratch + 仅放二进制；应用不发起外部 TLS，无需 CA 证书。
FROM scratch

COPY --from=build /out/backend /backend
COPY --from=build --chown=65534:65534 /data /data

# 以 nobody(65534) 身份运行，降低被攻陷后的影响面。
# 注意：挂载到 /data 的卷必须对 UID 65534 可写（命名卷会继承镜像里的属主；
# 若用宿主目录 bind-mount，需在宿主侧 chown 65534:65534）。
USER 65534:65534

# 容器内监听全部网卡，由 quadlet 的 PublishPort 限定到宿主回环。
ENV GUESTBOOK_ADDR=0.0.0.0:8787 \
    GUESTBOOK_DB_PATH=/data/guestbook.db

EXPOSE 8787
VOLUME ["/data"]

ENTRYPOINT ["/backend"]
